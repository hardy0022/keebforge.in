# Disposable-database configuration for local/E2E commands.
#
# Copy to .env.e2e.local and adjust if your container uses different settings:
#
#   cp .env.e2e.local.example .env.e2e.local
#
# Why this file name and not .env.local:
#
#   Next.js loads, first match winning, in this order:
#     .env.<NODE_ENV>.local   .env.local   .env.<NODE_ENV>   .env
#
#   The .env.local slot is included in PRODUCTION builds as well as development,
#   so a database URL placed there would shadow the production value in .env
#   during a production build. That is a production configuration change, so
#   .env.local is deliberately not used.
#
#   Next only ever loads .env.${NODE_ENV}, and NODE_ENV is never "e2e", so this
#   file is invisible to the application build. It cannot be picked up by
#   accident and cannot leak into production.
#
# The values below are dummy placeholders for the local container only. Never put
# a production credential in this file or in any tracked file.

# Loopback only. The guard refuses any non-loopback host.
DATABASE_URL=postgresql://keebforge:keebforge@localhost:55432/keebforge_e2e

# Must be the SAME host, port and database as DATABASE_URL.
# The Prisma CLI prefers DIRECT_URL, so a mismatch silently redirects commands.
DIRECT_URL=postgresql://keebforge:keebforge@localhost:55432/keebforge_e2e

# Allowed database names, enforced by scripts/e2e/scratch-guard.ts:
#   keebforge_e2e         - primary scratch database
#   keebforge_e2e_fresh   - empty database for from-empty migration checks