# ─── KeebForge.in environment ─────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# Public — safe to expose to the browser (prefix NEXT_PUBLIC_).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Realtime — live /track-order updates. URL + anon key are browser-safe; the
# service-role key is SERVER-ONLY (broadcast happens server-side, never shipped
# to the client). Requires Realtime Broadcast authorization for `tracking:*`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — never expose to client components, HTML, metadata, or logs.
DATABASE_URL=
DIRECT_URL=

# Authentication — Better Auth.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://keebforge.in
# Dash dashboard API key (create at https://dash.better-auth.com).
BETTER_AUTH_API_KEY=
# Sentinel security monitoring — per-project identify/KV endpoint
# (value shown in the Better Auth Infrastructure dashboard).
BETTER_AUTH_IDENTIFY_URL=https://kv.better-auth.com/projects/<your-project-id>
# Same URL, exposed to the browser bundle for sentinelClient() device identity.
# Public ingestion endpoint — NOT a secret.
NEXT_PUBLIC_BETTER_AUTH_IDENTIFY_URL=https://kv.better-auth.com/projects/<your-project-id>
# Social login (OAuth apps). Leave blank to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Media — Cloudinary. API secret is server-only; sign uploads server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
EMAIL_FROM=KeebForge <orders@keebforge.in>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED. Without it /api/payments/webhook rejects every event with HTTP 500
# and Razorpay gives up after its retries, so no order is ever reconciled from
# the gateway and only the browser's /api/payments/verify call can mark an order
# paid. Get it from Razorpay Dashboard -> Settings -> Webhooks -> your endpoint
# (https://dashboard.razorpay.com/app/webhooks) -> the "Secret" field, or set a
# new one with "Set secret". It is NOT RAZORPAY_KEY_SECRET and must not be
# replaced by a locally generated value: the HMAC is computed with this exact
# string, so a mismatch silently fails every signature check. A blank value is
# treated as unset and fails closed.
RAZORPAY_WEBHOOK_SECRET=
# Public Key ID — client-safe; used by checkout.js AND the EMI² Affordability Widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Shipping — Delhivery Express (kinko v1 charges API). Token is server-only.
# Staging base URL by default; switch to https://express.delhivery.com for production.
DELHIVERY_API_URL=https://staging-express.delhivery.com
DELHIVERY_API_TOKEN=
DELHIVERY_ORIGIN_PINCODE=
# Shipping mode offered at checkout: E=Express (default), S=Surface.
DELHIVERY_DEFAULT_MODE=E
# Optional comma list of modes shown in the UI, e.g. "S,E". Unset = default mode only.
DELHIVERY_MODES=S,E
# Subtotal (in rupees) at which shipping becomes free. Unset/0 disables the rule.
# FREE_SHIPPING_THRESHOLD=2000

# Pickup (warehouse) location used when manifesting shipments and booking
# courier pickups from admin Orders / Shipments.
#
# This is the AUTHORITATIVE source: it is read server-side only and is never
# sent to the browser. The Admin -> Settings pickup card has been removed.
# There is a legacy SiteSetting row (key `delhivery_pickup`) still present in
# the database; it is used ONLY as a fallback for any field left blank here, so
# set these to take full control.
#
# The warehouse must already be registered with Delhivery under
# DELHIVERY_PICKUP_ACCOUNT_NAME (their ClientWarehouse name), otherwise
# Delhivery refuses pickups with "Invalid Pickup Location".
# DELHIVERY_PICKUP_PIN is optional — if empty, DELHIVERY_ORIGIN_PINCODE is used.
# Leave values blank here; never commit the real address/phone/email.
DELHIVERY_PICKUP_NAME=
DELHIVERY_PICKUP_ADDRESS=
DELHIVERY_PICKUP_CITY=
DELHIVERY_PICKUP_PIN=
DELHIVERY_PICKUP_STATE=
DELHIVERY_PICKUP_COUNTRY=India
DELHIVERY_PICKUP_PHONE=
DELHIVERY_PICKUP_EMAIL=
DELHIVERY_PICKUP_ACCOUNT_NAME=
# Return (RTO) leg. Blank = fall back to the legacy DB row, then to the pickup
# values above. Never put real warehouse data here.
DELHIVERY_PICKUP_RETURN_ADDRESS=
DELHIVERY_PICKUP_RETURN_PIN=
DELHIVERY_PICKUP_RETURN_CITY=
DELHIVERY_PICKUP_RETURN_STATE=
DELHIVERY_PICKUP_RETURN_COUNTRY=

# ── Admin panel access ───────────────────────────────────────────────────────
# /admin is served when enabled and 404s (not 403, so the route is not
# confirmed) when disabled. requireAdminContext() still authorises every
# request — these flags only decide whether the panel is reachable at all.
# Both default to enabled, so existing deployments keep working until they opt
# out. The per-environment flag wins when set; blank or unset falls back to the
# master switch. Falsy spellings: false, 0, off, no. Any other non-blank value
# counts as enabled, so only set true/false.
#
# The production/public flag is what keeps the public site from exposing /admin
# while localhost keeps working. "Development" means an exact loopback host
# (localhost, 127.0.0.1, ::1, with or without a port) — a crafted Host such as
# localhost.evil.com counts as production. Set these in the deployment
# environment; the port is not a boundary.
ADMIN_PANEL_ENABLED=true
ADMIN_PANEL_PRODUCTION_ENABLED=false
ADMIN_PANEL_DEVELOPMENT_ENABLED=true