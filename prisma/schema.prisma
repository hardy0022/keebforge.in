/// What kind of customer notification an outbox row represents. Only one type
/// exists today; the enum keeps the uniqueness key `(orderId, type)` meaningful
/// when further transactional emails are added.
enum NotificationType {
  PAID_CONFIRMATION
}

/// Delivery lifecycle for one notification. The transitions are the point:
///
/// PENDING       — row exists, no send in flight. The only claimable state.
/// IN_PROGRESS   — a send is currently in flight (or a prior attempt died
/// mid-flight). Never auto-claimed: at most one automatic
/// attempt, so a crash here needs manual reconciliation.
/// SENT          — Resend confirmed acceptance (an email id was returned).
/// FAILED        — Resend returned a definitive rejection (4xx / validation).
/// Confirmed not delivered, so an explicit retry is safe.
/// NEEDS_REVIEW  — an ambiguous outcome (timeout/network/5xx): the message may
/// or may not have been accepted. Never auto-retried.
/// SUPPRESSED    — the admin disabled this email type: nothing was sent and
/// nothing should be. Terminal and NOT retryable, and distinct
/// from FAILED so a disabled type is never auto-resent.
enum NotificationStatus {
  PENDING
  IN_PROGRESS
  SENT
  FAILED
  NEEDS_REVIEW
  SUPPRESSED
}

