enum RefundStatus {
  /// `refund.created` — initiated at Razorpay, money not yet returned.
  CREATED
  /// `refund.processed` — money returned to the customer. Only this status moves
  /// `Payment.refundedAmount`.
  PROCESSED
  /// `refund.failed` — the refund did not happen. No money movement, and a later
  /// `refund.created` for the same id may still settle.
  FAILED
}

